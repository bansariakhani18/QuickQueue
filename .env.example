# Local Docker PostgreSQL configuration only. Do not use these values in production.
POSTGRES_DB=quickqueue
POSTGRES_USER=quickqueue
POSTGRES_PASSWORD=quickqueue_dev_only
POSTGRES_PORT=5433

# Prisma local development connection. Use a distinct, managed secret in production.
DATABASE_URL=postgresql://quickqueue:quickqueue_dev_only@localhost:5433/quickqueue?schema=public

# Local application URLs
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=3000
VITE_API_BASE_URL=http://localhost:3000
