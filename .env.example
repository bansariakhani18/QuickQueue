# Local Docker PostgreSQL configuration only. Do not use these values in production.
POSTGRES_DB=quickqueue
POSTGRES_USER=quickqueue
POSTGRES_PASSWORD=quickqueue_dev_only
POSTGRES_PORT=5433

# Prisma local development connection. Use a distinct, managed secret in production.
DATABASE_URL=postgresql://quickqueue:quickqueue_dev_only@localhost:5433/quickqueue?schema=public

# Local application URLs
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=3000
VITE_API_BASE_URL=http://localhost:3000

# Meta WhatsApp Cloud API (Phase 12, development/test environment only).
# Real values must live ONLY in backend/.env (Git-ignored) — never commit them.
# Copy these variable names into backend/.env and fill in the real Meta test
# values there.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
